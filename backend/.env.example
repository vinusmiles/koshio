# Copy to backend/.env for local development. Never commit the real .env.

# Local: SQLite file. Production: the Neon connection string, e.g.
# postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/koshio?sslmode=require
DATABASE_URL=sqlite:///./koshio.db

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# How long a sign-in lasts, in minutes (default 12 hours).
JWT_EXPIRE_MINUTES=720

# Web addresses allowed to use the API, comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173

# Sign-up closes automatically after the first account. Set to false to close it completely.
ALLOW_REGISTRATION=true
ALLOW_MULTIPLE_USERS=false

# Optional: lets Koshio ask Claude to suggest categories from merchant names (names only).
# Get a key at console.anthropic.com. Leave empty to turn the feature off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# development | production  (production hides API docs and requires a strong JWT_SECRET)
ENVIRONMENT=development
